
---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Image } from 'astro:assets';

const allSelectedImages = import.meta.glob(
  '../content/selected/**/*.{jpg,jpeg,png,webp}',
  { eager: true }
);

const selectedItems = Object.keys(allSelectedImages)
  .sort()
  .map(path => ({
    src: allSelectedImages[path].default,
  }));
---

<BaseLayout title="Selected Works | Marta Rodriguez Palau">
  <div
    class="site-container"
    style="padding-top: 0; padding-bottom: 4rem; position: relative; z-index: 1;"
  >
    <header class="selected-header">
      <h1>Senzills</h1>
    </header>

    <div class="justified-gallery" id="post-gallery">
      {selectedItems.map((item) => (
        <a
          href={item.src.src}
          class="gallery-item post-gallery-item"
          data-pswp-width={item.src.width}
          data-pswp-height={item.src.height}
        >
          <Image
            src={item.src}
            alt=""
            widths={[400, 800, 1200, 1600]}
            sizes="(max-width: 600px) 100vw, (max-width: 1200px) 50vw, 33vw"
          />
        </a>
      ))}
    </div>
  </div>
</BaseLayout>

<script>
  import { initJustifiedGallery } from '../scripts/gallery.js';

  let cleanup;

  const initializeGallery = () => {
    cleanup?.();

    cleanup = initJustifiedGallery('#post-gallery', {
      itemSelector: '.post-gallery-item',
      targetRowHeight: 300,
      spacing: 8,
      heightTolerance: 0.25,
    });
  };

  document.addEventListener('astro:page-load', initializeGallery);

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initializeGallery, { once: true });
  } else {
    initializeGallery();
  }

  document.addEventListener('astro:before-swap', () => {
    cleanup?.();
    cleanup = undefined;
  });
</script>

<style is:global>
  .justified-gallery {
    position: relative;
    width: 100%;
  }

  .justified-gallery .gallery-item {
    display: block;
    cursor: zoom-in;
    text-decoration: none;
    overflow: hidden;
  }

  .justified-gallery .gallery-item img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
    transition: filter 0.3s ease;
  }

  @media (hover: hover) {
    .justified-gallery .gallery-item:hover img {
      filter: grayscale(100%);
    }
  }
</style>
