
---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { Image, getImage } from 'astro:assets';

const projects = (await getCollection('projects'))
  .filter(p => p.id.endsWith('.ca'))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const allImages = import.meta.glob(
  '../../content/projects/**/*.{jpg,jpeg,png,webp}',
  { eager: true }
);

const projectsWithImages = await Promise.all(
  projects.map(async (p) => {
    const slug = p.id.replace('.ca', '').trim();
    const projectFolder = slug.toLowerCase();

    const coverPath = Object.keys(allImages).find(key => {
      const keyLower = key.toLowerCase();
      const fileName = key.split('/').pop().toLowerCase();

      return (
        keyLower.includes(`/projects/${projectFolder}/`) &&
        ['cover.jpg', 'cover.jpeg', 'cover.png', 'cover.webp'].includes(fileName)
      );
    });

    let coverImage = null;

    if (coverPath) {
      const src = allImages[coverPath].default;
      const optimized = await getImage({ src });

      coverImage = {
        src,
        width: optimized.attributes.width,
        height: optimized.attributes.height,
      };
    }

    return { ...p, slug, image: coverImage };
  })
);
---

<BaseLayout title="Projectes | Marta Rodriguez Palau">
  <div class="site-container" style="padding-top: 0; padding-bottom: 4rem;">
    <header class="selected-header">
      <h1>Projectes</h1>
    </header>

    <div id="projects-gallery" class="justified-gallery">
      {projectsWithImages.map((project) => (
        project.image && (
          <a
            href={`/proyectos/${project.slug}`}
            class="gallery-item"
            aria-label={`Veure el projecte ${project.data.title}`}
          >
            <Image
              src={project.image.src}
              alt={project.data.title}
              widths={[400, 800, 1200]}
              sizes="(max-width: 600px) 100vw, (max-width: 900px) 50vw, 33vw"
              width={project.image.width}
              height={project.image.height}
            />
          </a>
        )
      ))}
    </div>
  </div>
</BaseLayout>

<script>
  import { initJustifiedGallery } from '../../scripts/gallery.js';

  let cleanup;

  const initializeGallery = () => {
    cleanup?.();

    cleanup = initJustifiedGallery('#projects-gallery', {
      itemSelector: '.gallery-item',
      targetRowHeight: 280,
      spacing: 12,
      heightTolerance: 0.25,
    });
  };

  document.addEventListener('astro:page-load', initializeGallery);

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initializeGallery, { once: true });
  } else {
    initializeGallery();
  }

  document.addEventListener('astro:before-swap', () => {
    cleanup?.();
    cleanup = undefined;
  });
</script>

<style is:global>
  .justified-gallery {
    position: relative;
    width: 100%;
  }

  .justified-gallery .gallery-item {
    display: block;
    cursor: pointer;
    text-decoration: none;
    overflow: hidden;
    background-color: var(--surface-2);
  }

  .justified-gallery .gallery-item img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
    transition: filter 0.3s ease;
  }

  @media (hover: hover) {
    .justified-gallery .gallery-item:hover img {
      filter: grayscale(100%);
    }
  }
</style>
