---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { Image, getImage } from 'astro:assets';
import Expos from '../../components/expos.astro';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects
    .filter((p) => p.id.endsWith('.ca'))
    .map((p) => {
      const slug = p.id.replace('.ca', '').trim();
      return {
        params: { slug: slug },
        props: { project: p },
      };
    });
}

const { project } = Astro.props;
const { Content } = await render(project);
const allImages = import.meta.glob('../../content/projects/**/*.{jpg,jpeg,png,webp}', { eager: true });

const projectFolder = project.id.replace('.ca', '').trim().toLowerCase();

const isCover = (path) => {
  const fileName = path.split('/').pop().toLowerCase();
  return fileName === 'cover.jpg' || fileName === 'cover.jpeg' || fileName === 'cover.png' || fileName === 'cover.webp';
};

const galleryPaths = Object.keys(allImages).filter(key => {
  const keyLower = key.toLowerCase();
  return keyLower.includes(`/projects/${projectFolder}/`) && !isCover(key);
});

const coverPath = Object.keys(allImages).find(key => {
  const keyLower = key.toLowerCase();
  return keyLower.includes(`/projects/${projectFolder}/`) && isCover(key);
});

let coverImage = null;
if (coverPath) {
  const src = allImages[coverPath].default;
  const optimized = await getImage({ src });
  coverImage = { src, width: optimized.attributes.width, height: optimized.attributes.height };
}

// Calculamos el aspect ratio (ancho / alto) para saber si es vertical u horizontal
const galleryImages = await Promise.all(galleryPaths.map(async (key) => {
  const src = allImages[key].default;
  const optimized = await getImage({ src });
  const ar = optimized.attributes.width / optimized.attributes.height;
  const isVertical = ar < 1; // Si el ancho es menor que el alto, es vertical
  return { src, width: optimized.attributes.width, height: optimized.attributes.height, ar, isVertical };
}));

const sliderImages = galleryImages;

const getTagColor = (tag) => {
  const normalized = tag.toLowerCase().normalize("NFD").replace(/[\u0300-\u036f]/g, "").replace(/·/g, "").replace(/ll/g, "l");
  const colors = { 'fotografia': 'bg-blue-500', 'ilustracio': 'bg-green-500', 'pintura': 'bg-red-500', 'gravat': 'bg-yellow-500', 'dibuix': 'bg-orange-500', 'video': 'bg-purple-500', 'poesia': 'bg-pink-500', 'literatura': 'bg-amber-500', 'mixte': 'bg-teal-500', 'aquarela': 'bg-cyan-500' };
  return colors[normalized] || 'bg-gray-500';
};
---

<BaseLayout title={`${project.data.title} | Marta Rodriguez Palau`} description={project.data.description}>
  
  <div id="project-gallery-container">
    <div class="slider-container" id="slider-container">
      <div class="slider-track" id="slider-track">
        {sliderImages.map((img, index) => (
          <a href={img.src.src} class="slider-item" data-pswp-width={img.width} data-pswp-height={img.height}>
            <Image src={img.src} alt="" width={img.width} height={img.height} loading={index === 0 ? "eager" : "lazy"} />
          </a>
        ))}
      </div>
    </div>

    <div class="mosaic-container" id="mosaic-container" style="display: none;">
      <div class="site-container" style="padding-top: 2rem; padding-bottom: 2rem;">
        <div class="editorial-grid">
          {galleryImages.map((img) => (
            <a 
              href={img.src.src} 
              class={`post-gallery-item ${img.isVertical ? 'is-vertical' : 'is-horizontal'}`} 
              data-pswp-width={img.width} 
              data-pswp-height={img.height}
            >
              <Image src={img.src} alt="" widths={[400, 800, 1200]} sizes="(max-width: 800px) 100vw, 50vw" width={img.width} height={img.height} />
            </a>
          ))}
        </div>
      </div>
    </div>
  </div>

  <!-- LAYOUT EDITORIAL -->
  <div class="content-container">
    <div class="project-layout">
      
      <!-- COLUMNA IZQUIERDA -->
      <div class="project-sidebar">
        <h1 class="project-title">{project.data.title}</h1>
        
        <div class="project-meta-row">
          {project.data.date && (
            <span class="project-year">{project.data.date.getFullYear()}</span>
          )}
          
          <button id="toggle-gallery-btn" class="toggle-gallery-btn" aria-label="Alternar vista" title="Ver galería/mosaico">
            <svg id="icon-grid" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7"></rect><rect x="14" y="3" width="7" height="7"></rect><rect x="14" y="14" width="7" height="7"></rect><rect x="3" y="14" width="7" height="7"></rect></svg>
            <svg id="icon-slider" style="display: none;" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect></svg>
          </button>
        </div>

        <div class="project-tags">
          {project.data.tags?.map(tag => (
            <span class="tag-text">{tag}</span>
          ))}
        </div>

        <Expos cv={project.data.cv} lang="ca" />
      </div>

      <!-- COLUMNA DERECHA -->
      <div class="project-main">
        <p class="project-summary">{project.data.description}</p>
        
        <div class="prose">
          <Content components={{ img: (props) => <Image {...props} widths={[800, 1200]} sizes="(max-width: 800px) 100vw, 800px" style="width: 100%; height: auto; border-radius: 0; margin: 2rem 0;" /> }} />
        </div>
      </div>

    </div>
  </div>

</BaseLayout>

<style>
  /* SLIDER */
  #project-gallery-container { width: 100%; margin-bottom: 3rem; }
  .slider-container { width: 100%; overflow-x: auto; scroll-snap-type: x mandatory; scrollbar-width: none; }
  .slider-container::-webkit-scrollbar { display: none; }
  .slider-track { display: flex; height: 70vh; align-items: center; }
  .slider-item { flex: 0 0 100%; height: 100%; scroll-snap-align: center; display: flex; justify-content: center; align-items: center; padding: 2rem; box-sizing: border-box; cursor: zoom-in; text-decoration: none; }
  .slider-item img { max-width: 100%; max-height: 100%; object-fit: contain; }

  /* MOSAICO EDITORIAL AVANZADO */
  .editorial-grid {
    display: grid;
    /* 3 columnas iguales */
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
    grid-auto-flow: dense; /* Rellena los huecos */
    width: 100%;
  }

  .post-gallery-item {
    display: block;
    cursor: zoom-in;
    text-decoration: none;
    overflow: hidden;
    background-color: var(--surface-2);
    position: relative;
    width: 100%;
    height: 100%;
  }

  .post-gallery-item img {
    width: 100%;
    height: 100%;
    object-fit: cover; /* Se adapta al hueco */
    display: block;
    transition: transform 0.4s ease;
  }

  /* Las imágenes verticales ocupan 1 columna y 2 filas de alto */
  .is-vertical {
    grid-column: span 1;
    grid-row: span 2;
  }

  /* Las imágenes horizontales ocupan 1 columna y 1 fila de alto */
  .is-horizontal {
    grid-column: span 1;
    grid-row: span 1;
  }

  .post-gallery-item:hover img {
    transform: scale(1.05);
  }

  /* Responsive */
  @media (max-width: 900px) {
    .editorial-grid {
      grid-template-columns: repeat(2, 1fr); /* 2 columnas en tablet */
    }
  }

  @media (max-width: 600px) {
    .editorial-grid {
      grid-template-columns: 1fr; /* 1 columna en móvil */
    }
    .is-vertical, .is-horizontal {
      grid-column: span 1;
      grid-row: span 1;
      aspect-ratio: auto; /* Dejamos que fluya en móvil */
    }
  }

  /* LAYOUT EDITORIAL */
  .project-layout { display: grid; grid-template-columns: 1fr 2fr; gap: 4rem; padding: 2rem 0 6rem 0; align-items: start; }
  .project-sidebar { display: flex; flex-direction: column; gap: 0.5rem; position: sticky; top: 6rem; align-self: start; }
  .project-title { font-size: 2.5rem; font-weight: 600; line-height: 1.1; margin: 0; color: var(--text-1); margin-bottom: 0.5rem; }
  .project-meta-row { display: flex; align-items: center; justify-content: space-between; gap: 1rem; margin-bottom: 0.5rem; }
  .project-year { font-size: 1rem; color: var(--text-2); }
  .toggle-gallery-btn { background: transparent; border: 1px solid var(--border); color: var(--text-1); padding: 0.4rem; cursor: pointer; border-radius: 4px; transition: all 0.2s; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
  .toggle-gallery-btn:hover { background: var(--surface-2); }
  .project-tags { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 0.5rem; }
  .tag-text { font-size: 0.8rem; color: var(--text-2); text-transform: uppercase; letter-spacing: 0.05em; }
  .project-main { display: flex; flex-direction: column; margin-top: -0.9rem; }
  .project-summary { font-size: 1.5rem; line-height: 1.5; margin-top: 0; margin-bottom: 3rem; color: var(--text-1); font-weight: 500; }

  @media (max-width: 900px) {
    .project-layout { grid-template-columns: 1fr; gap: 1rem; padding-bottom: 2rem; }
    .project-sidebar { position: static; }
    .project-title { font-size: 2rem; }
    .project-main { margin-top: 0; }
    .project-summary { font-size: 1.2rem; margin-top: 1rem; }
    .slider-track { height: 50vh; }
    .slider-item { padding: 1rem; }
  }
</style>

<script>
  document.addEventListener('astro:page-load', () => {
    const toggleBtn = document.getElementById('toggle-gallery-btn');
    const sliderContainer = document.getElementById('slider-container');
    const mosaicContainer = document.getElementById('mosaic-container');
    const iconGrid = document.getElementById('icon-grid');
    const iconSlider = document.getElementById('icon-slider');

    if (toggleBtn && sliderContainer && mosaicContainer) {
      toggleBtn.addEventListener('click', () => {
        const isSliderVisible = sliderContainer.style.display !== 'none';
        if (isSliderVisible) {
          sliderContainer.style.display = 'none'; 
          mosaicContainer.style.display = 'block';
          iconGrid.style.display = 'none'; 
          iconSlider.style.display = 'block';
        } else {
          sliderContainer.style.display = 'block'; 
          mosaicContainer.style.display = 'none';
          iconGrid.style.display = 'block'; 
          iconSlider.style.display = 'none';
        }
      });
    }
  });
</script>