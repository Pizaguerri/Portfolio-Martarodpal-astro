
---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { Image, getImage } from 'astro:assets';
import Expos from '../../components/expos.astro';
import Tags from '../../components/Tags.astro';
import Disclosure from '../../components/Disclosure.astro';
import { useTranslations } from '../../i18n/utils';

const t = useTranslations('ca');

export async function getStaticPaths() {
  const projects = await getCollection('projects');

  return projects
    .filter((p) => p.id.endsWith('.ca'))
    .map((p) => {
      const slug = p.id.replace('.ca', '').trim();

      return {
        params: { slug },
        props: { project: p },
      };
    });
}

const { project } = Astro.props;
const { Content } = await render(project);

const allImages = import.meta.glob(
  '../../content/projects/**/*.{jpg,jpeg,png,webp}',
  { eager: true }
);

const projectFolder = project.id
  .replace('.ca', '')
  .trim()
  .toLowerCase();

const isCover = (path) => {
  const fileName = path.split('/').pop().toLowerCase();

  return [
    'cover.jpg',
    'cover.jpeg',
    'cover.png',
    'cover.webp',
  ].includes(fileName);
};

const projectImagePaths = Object.keys(allImages).filter((key) =>
  key.toLowerCase().includes(`/projects/${projectFolder}/`)
);

const coverPath = projectImagePaths.find(isCover);

const galleryPaths = projectImagePaths
  .filter((key) => !isCover(key))
  .sort();

const optimizeImage = async (key) => {
  const src = allImages[key].default;
  const optimized = await getImage({ src });

  return {
    src,
    width: optimized.attributes.width,
    height: optimized.attributes.height,
  };
};

const galleryImages = await Promise.all(
  galleryPaths.map(optimizeImage)
);

const sliderImages = galleryImages;

const englishSummary = project.data.summary_en?.trim();
---

<BaseLayout
  title={`${project.data.title} | Marta Rodriguez Palau`}
  description={project.data.description}
>
  <div id="project-gallery-container">

    <!-- SLIDER HORIZONTAL -->
    <div
      class="slider-container"
      id="slider-container"
      data-pswp-active="true"
    >
      <div class="slider-track" id="slider-track">
        {sliderImages.map((img, index) => (
          <a
            href={img.src.src}
            class="slider-item"
            data-pswp-width={img.width}
            data-pswp-height={img.height}
          >
            <Image
              src={img.src}
              alt=""
              width={img.width}
              height={img.height}
              loading={index === 0 ? 'eager' : 'lazy'}
            />
          </a>
        ))}
      </div>
    </div>

    <!-- MOSAICO JUSTIFICADO -->
    <div
      class="mosaic-container"
      id="mosaic-container"
      data-pswp-active="false"
      style="display: none;"
    >
      <div class="site-container mosaic-inner">
        <div class="justified-gallery" id="project-mosaic-gallery">
          {galleryImages.map((img) => (
            <a
              href={img.src.src}
              class="gallery-item post-gallery-item"
              data-pswp-width={img.width}
              data-pswp-height={img.height}
            >
              <Image
                src={img.src}
                alt=""
                widths={[400, 800, 1200]}
                sizes="(max-width: 800px) 100vw, 50vw"
                width={img.width}
                height={img.height}
              />
            </a>
          ))}
        </div>
      </div>
    </div>

  </div>

  <!-- LAYOUT EDITORIAL -->
  <div class="content-container">
    <div class="project-layout">

      <!-- COLUMNA IZQUIERDA -->
      <div class="project-sidebar">
        <h1 class="project-title">{project.data.title}</h1>

        <div class="project-meta-row">
          {project.data.date && (
            <span class="project-year">
              {project.data.date.getFullYear()}
            </span>
          )}

          <button
            id="toggle-gallery-btn"
            class="toggle-gallery-btn"
            aria-label="Alternar vista"
            title="Ver galería/mosaico"
            aria-pressed="false"
            type="button"
          >
            <svg
              id="icon-grid"
              xmlns="http://www.w3.org/2000/svg"
              width="20"
              height="20"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <rect x="3" y="3" width="7" height="7"></rect>
              <rect x="14" y="3" width="7" height="7"></rect>
              <rect x="14" y="14" width="7" height="7"></rect>
              <rect x="3" y="14" width="7" height="7"></rect>
            </svg>

            <svg
              id="icon-slider"
              style="display: none;"
              xmlns="http://www.w3.org/2000/svg"
              width="20"
              height="20"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <rect
                x="3"
                y="3"
                width="18"
                height="18"
                rx="2"
                ry="2"
              ></rect>
            </svg>
          </button>
        </div>

        <Tags tags={project.data.tags} />

        <Expos cv={project.data.cv} lang="ca" />

        {englishSummary && (
          <Disclosure title={t('englishSummary')}>
            <p>{englishSummary}</p>
          </Disclosure>
        )}
      </div>

      <!-- COLUMNA DERECHA -->
      <div class="project-main">
        <p class="project-summary">
          {project.data.description}
        </p>

        <div class="prose">
          <Content
            components={{
              img: (props) => (
                <Image
                  {...props}
                  widths={[800, 1200]}
                  sizes="(max-width: 800px) 100vw, 800px"
                  style="width: 100%; height: auto; border-radius: 0; margin: 2rem 0;"
                />
              ),
            }}
          />
        </div>
      </div>

    </div>
  </div>
</BaseLayout>

<style>
  /* SLIDER HORIZONTAL */

  #project-gallery-container {
    width: 100%;
    margin-bottom: 3rem;
  }

  .slider-container {
    width: 100%;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
  }

  .slider-container::-webkit-scrollbar {
    display: none;
  }

  .slider-track {
    display: flex;
    height: 70vh;
    align-items: center;
  }

  .slider-item {
    flex: 0 0 100%;
    height: 100%;
    scroll-snap-align: center;
    display: flex;
    justify-content: center;
    align-items: center;
    padding: 2rem;
    box-sizing: border-box;
    cursor: zoom-in;
    text-decoration: none;
  }

  .slider-item img {
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
  }

  /* MOSAICO JUSTIFICADO */

  .mosaic-container {
    width: 100%;
  }

  .mosaic-inner {
    padding-top: 2rem;
    padding-bottom: 2rem;
  }

  .justified-gallery {
    position: relative;
    width: 100%;
  }

  .justified-gallery .gallery-item {
    display: block;
    cursor: zoom-in;
    text-decoration: none;
    overflow: hidden;
    background-color: var(--surface-2);
  }

  .justified-gallery .gallery-item img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
    transition: filter 0.3s ease;
  }

  @media (hover: hover) {
    .justified-gallery .gallery-item:hover img {
      filter: grayscale(100%);
    }
  }

  /* LAYOUT EDITORIAL */

  .project-layout {
    display: grid;
    grid-template-columns: 1fr 2fr;
    gap: 4rem;
    padding: 2rem 0 6rem 0;
    align-items: start;
  }

  .project-sidebar {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    position: sticky;
    top: 6rem;
    align-self: start;
  }

  .project-title {
    font-size: 2.5rem;
    font-weight: 600;
    line-height: 1.1;
    margin: 0 0 0.5rem;
    color: var(--text-1);
  }

  .project-meta-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 0.5rem;
  }

  .project-year {
    font-size: 1rem;
    color: var(--text-2);
  }

  .toggle-gallery-btn {
    background: transparent;
    border: 1px solid var(--border);
    color: var(--text-1);
    padding: 0.4rem;
    cursor: pointer;
    border-radius: 4px;
    transition: all 0.2s;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .toggle-gallery-btn:hover {
    background: var(--surface-2);
  }

  .project-main {
    display: flex;
    flex-direction: column;
    margin-top: -0.9rem;
  }

  .project-summary {
    font-size: 1.5rem;
    line-height: 1.5;
    margin-top: 0;
    margin-bottom: 3rem;
    color: var(--text-1);
    font-weight: 500;
  }

  /* RESPONSIVE */

  @media (max-width: 900px) {
    .project-layout {
      grid-template-columns: 1fr;
      gap: 1rem;
      padding-bottom: 2rem;
    }

    .project-sidebar {
      position: static;
    }

    .project-title {
      font-size: 2rem;
    }

    .project-main {
      margin-top: 0;
    }

    .project-summary {
      font-size: 1.2rem;
      margin-top: 1rem;
    }

    .slider-track {
      height: 50vh;
    }

    .slider-item {
      padding: 1rem;
    }
  }
</style>

<script>
  import { initJustifiedGallery } from '../../scripts/gallery.js';

  let cleanupGallery = null;
  let toggleHandler = null;

  function setActiveView(isMosaic) {
    const sliderContainer = document.getElementById('slider-container');
    const mosaicContainer = document.getElementById('mosaic-container');
    const iconGrid = document.getElementById('icon-grid');
    const iconSlider = document.getElementById('icon-slider');
    const toggleBtn = document.getElementById('toggle-gallery-btn');

    if (
      !sliderContainer ||
      !mosaicContainer ||
      !iconGrid ||
      !iconSlider ||
      !toggleBtn
    ) {
      return;
    }

    sliderContainer.style.display = isMosaic ? 'none' : 'block';
    mosaicContainer.style.display = isMosaic ? 'block' : 'none';

    sliderContainer.dataset.pswpActive = String(!isMosaic);
    mosaicContainer.dataset.pswpActive = String(isMosaic);

    iconGrid.style.display = isMosaic ? 'none' : 'block';
    iconSlider.style.display = isMosaic ? 'block' : 'none';

    toggleBtn.setAttribute('aria-pressed', String(isMosaic));

    cleanupGallery?.();
    cleanupGallery = null;

    if (isMosaic) {
      const gallery = document.getElementById('project-mosaic-gallery');

      if (gallery) {
        cleanupGallery = initJustifiedGallery(gallery, {
          itemSelector: '.gallery-item',
          targetRowHeight: 288,
          spacing: 12,
          heightTolerance: 0.25,
        });
      }
    }
  }

  function initProjectGallery() {
    cleanupGallery?.();
    cleanupGallery = null;

    const toggleBtn = document.getElementById('toggle-gallery-btn');

    if (!toggleBtn) return;

    if (toggleHandler) {
      toggleBtn.removeEventListener('click', toggleHandler);
    }

    toggleHandler = () => {
      const mosaicContainer = document.getElementById('mosaic-container');

      if (!mosaicContainer) return;

      const isMosaicVisible =
        mosaicContainer.style.display !== 'none';

      setActiveView(!isMosaicVisible);

      window.scrollTo({
        top: 0,
        behavior: 'smooth',
      });
    };

    toggleBtn.addEventListener('click', toggleHandler);

    setActiveView(false);
  }

  function cleanupProjectGallery() {
    cleanupGallery?.();
    cleanupGallery = null;

    const toggleBtn = document.getElementById('toggle-gallery-btn');

    if (toggleBtn && toggleHandler) {
      toggleBtn.removeEventListener('click', toggleHandler);
    }

    toggleHandler = null;
  }

  document.addEventListener('astro:page-load', initProjectGallery);
  document.addEventListener('astro:before-swap', cleanupProjectGallery);

  initProjectGallery();
</script>
