---
interface CV {
  exposicions?: string[];
  llibres?: string[];
  premis?: string[];
  'col·laboracions'?: string[];
}

interface Props {
  cv?: CV;
  lang?: 'ca' | 'es' | 'en';
}

const { cv = {}, lang = 'ca' } = Astro.props;

const labels = {
  ca: {
    exposicions: 'EXPOSICIONS',
    llibres: 'LLIBRES',
    premis: 'PREMIS',
    colaboracions: 'COL·LABORACIONS',
  },
  es: {
    exposicions: 'EXPOSICIONES',
    llibres: 'LIBROS',
    premis: 'PREMIOS',
    colaboracions: 'COLABORACIONES',
  },
  en: {
    exposicions: 'EXHIBITIONS',
    llibres: 'BOOKS',
    premis: 'AWARDS',
    colaboracions: 'COLLABORATIONS',
  },
};

const l = labels[lang];

const sections = [
  {
    label: l.exposicions,
    items: cv.exposicions || [],
  },
  {
    label: l.llibres,
    items: cv.llibres || [],
  },
  {
    label: l.premis,
    items: cv.premis || [],
  },
  {
    label: l.colaboracions,
    items: cv['col·laboracions'] || [],
  },
];

const visibleSections = sections.filter(
  (section) => section.items.length > 0
);
---

{visibleSections.length > 0 && (
  <div class="cv">
    {visibleSections.map((section) => (
      <section class="cv-section">
        <h3 class="cv-heading">{section.label}</h3>

        <ul class="cv-list">
          {section.items.map((item) => (
            <li>{item}</li>
          ))}
        </ul>
      </section>
    ))}
  </div>
)}

<style>
  .cv {
    margin: 0;
  }

  .cv-section {
    margin: 0;
  }

  .cv-heading {
    margin: 0;
    padding: 1rem 0;
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    color: var(--text-1);
    text-transform: uppercase;
  }

  .cv-list {
    list-style: none;
    padding: 0;
    margin: 0 0 1rem 0;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .cv-list li {
    font-size: 0.85rem;
    color: var(--text-2);
    line-height: 1.4;
    padding: 0;
  }
</style>