---
interface Props {
  cv?: any;
  lang?: string;
}

const props = Astro.props;
const cv = props.cv || {};
const lang = props.lang || 'ca';

const labels: Record<string, any> = {
  ca: { exposicions: 'EXPOSICIONS', llibres: 'LLIBRES', premis: 'PREMIS', colaboracions: 'COL·LABORACIONS' },
  es: { exposicions: 'EXPOSICIONES', llibres: 'LIBROS', premis: 'PREMIOS', colaboracions: 'COLABORACIONES' },
  en: { exposicions: 'EXHIBITIONS', llibres: 'BOOKS', premis: 'AWARDS', colaboracions: 'COLLABORATIONS' },
};

const l = labels[lang] || labels.ca;

const exposicions = cv.exposicions || [];
const llibres = cv.llibres || [];
const premis = cv.premis || [];
const colaboracions = cv['col·laboracions'] || [];

const hasData = exposicions.length > 0 || llibres.length > 0 || premis.length > 0 || colaboracions.length > 0;
---

{hasData && (
  <div class="cv-accordion">
    {exposicions.length > 0 && (
      <details class="cv-group" name="cv-accordion-group">
        <summary class="cv-heading">
          {l.exposicions}
          <svg class="cv-icon" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"></polyline></svg>
        </summary>
        <ul class="cv-list">
          {exposicions.map((item: string) => <li>{item}</li>)}
        </ul>
      </details>
    )}

    {llibres.length > 0 && (
      <details class="cv-group" name="cv-accordion-group">
        <summary class="cv-heading">
          {l.llibres}
          <svg class="cv-icon" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"></polyline></svg>
        </summary>
        <ul class="cv-list">
          {llibres.map((item: string) => <li>{item}</li>)}
        </ul>
      </details>
    )}

    {premis.length > 0 && (
      <details class="cv-group" name="cv-accordion-group">
        <summary class="cv-heading">
          {l.premis}
          <svg class="cv-icon" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"></polyline></svg>
        </summary>
        <ul class="cv-list">
          {premis.map((item: string) => <li>{item}</li>)}
        </ul>
      </details>
    )}

    {colaboracions.length > 0 && (
      <details class="cv-group" name="cv-accordion-group">
        <summary class="cv-heading">
          {l.colaboracions}
          <svg class="cv-icon" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"></polyline></svg>
        </summary>
        <ul class="cv-list">
          {colaboracions.map((item: string) => <li>{item}</li>)}
        </ul>
      </details>
    )}
  </div>
)}

<style>
  .cv-accordion { margin-top: 0; } /* Quitamos el margen para que fluya con el texto */
  .cv-heading {
    font-size: 0.8rem; font-weight: 700; letter-spacing: 0.05em;
    padding: 1rem 0; cursor: pointer; list-style: none;
    display: flex; justify-content: space-between; align-items: center;
    color: var(--text-1); transition: color 0.3s ease; user-select: none;
    text-transform: uppercase;
  }
  .cv-heading::-webkit-details-marker { display: none; }
  .cv-heading:hover { color: #6F362B; }
  .cv-icon { width: 14px; height: 14px; transition: transform 0.3s ease, color 0.3s ease; }
  details[open] .cv-icon { transform: rotate(180deg); color: #6F362B; }
  .cv-list { list-style: none; padding: 0; margin: 0 0 1rem 0; display: flex; flex-direction: column; gap: 0.4rem; }
  .cv-list li { font-size: 0.85rem; color: var(--text-2); line-height: 1.4; padding-left: 0; }
</style>